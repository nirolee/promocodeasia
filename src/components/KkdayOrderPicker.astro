---
import { productOptions, type PickerOffer } from '../lib/kkday-order-picker';

const { offers } = Astro.props as { offers: PickerOffer[] };
---
<details class="picker" data-kkday-picker data-offers={JSON.stringify(offers)}>
  <summary class="picker-head">
    <span class="picker-icon" aria-hidden="true">
      <svg viewBox="0 0 28 28" fill="none" width="28" height="28">
        <path d="M5 7h18v4a3 3 0 0 0 0 6v4H5v-4a3 3 0 0 0 0-6V7Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
        <path d="m11 14 2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <span class="picker-intro">
      <span class="picker-kicker">KKday 台灣站 · 折扣試算</span>
      <strong>這筆訂單，先試哪張券？</strong>
      <span class="picker-description">依金額、商品和付款方式，找出值得先試的折扣。</span>
    </span>
    <span class="picker-toggle" aria-hidden="true"><span>開始試算</span><svg viewBox="0 0 16 16" fill="none" width="16" height="16"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
  </summary>
  <div class="picker-body">
    <form data-picker-form novalidate>
      <fieldset disabled data-picker-fields>
        <legend class="visually-hidden">你的 KKday 訂單條件</legend>
        <div class="picker-fields">
          <div class="picker-field">
            <label for="kkday-picker-amount">單筆可折抵金額</label>
            <div class="picker-amount"><span aria-hidden="true">NT$</span><input id="kkday-picker-amount" type="text" inputmode="decimal" placeholder="例如 3,600" maxlength="16" autocomplete="off" aria-describedby="kkday-picker-help kkday-picker-error" required /></div>
          </div>
          <div class="picker-field">
            <label for="kkday-picker-product">商品類型</label>
            <select id="kkday-picker-product">
              <option value="">還不確定</option>
              {productOptions.map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </div>
          <div class="picker-field">
            <label for="kkday-picker-payment">你可使用的付款方式</label>
            <select id="kkday-picker-payment">
              <option value="">還不確定</option>
              <option value="next">將來銀行信用卡（直接刷卡）</option>
              <option value="jcb">台灣 JCB 晶緻級以上（直接刷卡）</option>
              <option value="both">上述兩種卡都可用</option>
              <option value="other">其他卡別／電子錢包</option>
            </select>
          </div>
          <div class="picker-field">
            <label for="kkday-picker-travel">使用／出發日 <small>選填</small></label>
            <input id="kkday-picker-travel" type="date" aria-describedby="kkday-picker-error" />
          </div>
        </div>
        <p class="picker-note" id="kkday-picker-help">以台灣會員、同商品同出發日的一筆訂單計算。扣掉不可折抵的費用後再填金額。</p>
        <p class="picker-error" id="kkday-picker-error" role="alert"></p>
        <button class="picker-submit" type="submit">查看試算結果 <span aria-hidden="true">→</span></button>
      </fieldset>
    </form>
    <noscript><p class="picker-note">請開啟 JavaScript 試算，或查看下方各券的適用條件。</p></noscript>
    <p class="picker-note picker-unavailable" data-picker-unavailable hidden>目前沒有仍在期限內、可供試算的折扣。可查看下方優惠列表。</p>
    <div class="picker-results" data-picker-results hidden>
      <h3 data-picker-title tabindex="-1"></h3>
      <p class="picker-note" data-picker-status role="status"></p>
      <div data-picker-matches></div>
      <details class="picker-extra" data-picker-pending hidden>
        <summary data-picker-pending-label></summary>
        <div data-picker-pending-list></div>
      </details>
      <details class="picker-extra" data-picker-excluded hidden>
        <summary data-picker-excluded-label></summary>
        <ul data-picker-excluded-list></ul>
      </details>
    </div>
    <p class="picker-foot">試算涵蓋部分已核對的折扣碼，各券分開計算。實際商品、帳號資格、名額和折抵金額以 KKday 結帳為準。填入的金額與條件只在瀏覽器內計算。</p>
  </div>
  <template data-picker-result-card>
    <article class="picker-result">
      <div class="picker-result-head">
        <div><p class="picker-result-label" data-result-label></p><strong data-result-benefit></strong></div>
        <span class="picker-savings" data-result-savings></span>
      </div>
      <p class="picker-note" data-result-detail></p>
      <div class="picker-result-actions">
        <code data-result-code></code>
        <button class="copybtn" type="button" data-brand="kkday">複製折扣碼</button>
        <a class="js-source" data-brand="kkday" rel="nofollow noopener" target="_blank"></a>
      </div>
    </article>
  </template>
</details>

<script>
  import { assessOffer, currentPickerOffers, type PickerOffer } from '../lib/kkday-order-picker';
  import { money, parseAmount } from '../lib/coupon-math.mjs';
  import { todayTW } from '../lib/codes';

  const picker = document.querySelector<HTMLDetailsElement>('[data-kkday-picker]');
  if (picker) {
    const find = <T extends HTMLElement>(selector: string) => picker.querySelector<T>(selector)!;
    const offers: PickerOffer[] = JSON.parse(picker.dataset.offers || '[]');
    const form = find<HTMLFormElement>('[data-picker-form]');
    const fields = find<HTMLFieldSetElement>('[data-picker-fields]');
    const amount = find<HTMLInputElement>('#kkday-picker-amount');
    const product = find<HTMLSelectElement>('#kkday-picker-product');
    const payment = find<HTMLSelectElement>('#kkday-picker-payment');
    const travel = find<HTMLInputElement>('#kkday-picker-travel');
    const error = find('#kkday-picker-error');
    const results = find('[data-picker-results]');
    const title = find('[data-picker-title]');
    const status = find('[data-picker-status]');
    const matchList = find('[data-picker-matches]');
    const pendingBox = find<HTMLDetailsElement>('[data-picker-pending]');
    const pendingList = find('[data-picker-pending-list]');
    const excludedBox = find<HTMLDetailsElement>('[data-picker-excluded]');
    const excludedList = find('[data-picker-excluded-list]');
    const template = find<HTMLTemplateElement>('[data-picker-result-card]');

    function showAvailability(today: string) {
      const active = currentPickerOffers(offers, today);
      form.hidden = active.length === 0;
      find('[data-picker-unavailable]').hidden = active.length > 0;
      fields.disabled = active.length === 0;
      travel.min = today;
      return active;
    }

    function resultCard(offer: ReturnType<typeof assessOffer>, first: boolean) {
      const { coupon, rule, estimate, reasons } = offer;
      const card = template.content.cloneNode(true) as DocumentFragment;
      card.querySelector('[data-result-label]')!.textContent = offer.status === 'pending'
        ? '條件待確認' : first ? '符合已填條件 · 優先試用' : '符合已填條件';
      card.querySelector('[data-result-benefit]')!.textContent = coupon.benefit;
      const savingLabel = offer.status === 'pending' ? '若符合可省' : '估省';
      card.querySelector('[data-result-savings]')!.textContent = `${savingLabel} ${money(estimate.savingCents)}`;
      const guidance = rule.claimFirst ? '先從官方活動頁領券，再回 KKday 結帳。' : '請從官方頁確認適用商品與付款條件。';
      card.querySelector('[data-result-detail]')!.textContent = offer.status === 'pending'
        ? reasons.join('、') + '。' : `試算折後金額 ${money(estimate.payableCents)}。 ${guidance}`;
      card.querySelector('[data-result-code]')!.textContent = coupon.code;
      const copy = card.querySelector<HTMLButtonElement>('.copybtn')!;
      copy.dataset.code = coupon.code;
      copy.dataset.commissionable = coupon.commissionable ?? 'unknown';
      copy.hidden = offer.status === 'pending';
      const link = card.querySelector<HTMLAnchorElement>('.js-source')!;
      link.href = coupon.source;
      link.dataset.codeId = coupon.code;
      link.textContent = rule.claimFirst ? '查看官方領券頁 ↗' : '查看官方條款 ↗';
      return card;
    }

    function render(focusResult: boolean) {
      const today = todayTW();
      const active = showAvailability(today);
      results.hidden = true;
      error.textContent = '';
      amount.removeAttribute('aria-invalid');
      travel.removeAttribute('aria-invalid');
      if (!active.length) return;
      const raw = amount.value.trim();
      const cents = parseAmount(/^\d{1,3}(,\d{3})+(\.\d{1,2})?$/.test(raw) ? raw.replaceAll(',', '') : raw);
      if (cents === null) {
        error.textContent = '請輸入大於 0、最多兩位小數、NT$1,000,000 以內的金額。';
        amount.setAttribute('aria-invalid', 'true');
        if (focusResult) amount.focus();
        return;
      }
      if (travel.value && travel.value < today) {
        error.textContent = '使用／出發日不可早於今天。';
        travel.setAttribute('aria-invalid', 'true');
        if (focusResult) travel.focus();
        return;
      }
      const assessed = active.map(offer => assessOffer(offer, cents, product.value, payment.value, travel.value))
        .sort((a, b) => b.estimate.savingCents - a.estimate.savingCents);
      const matches = assessed.filter(offer => offer.status === 'match');
      const pending = assessed.filter(offer => offer.status === 'pending');
      const excluded = assessed.filter(offer => offer.status === 'excluded');
      title.textContent = matches.length ? '建議試用順序' : pending.length ? '再確認這些條件' : '目前沒有符合的試算券';
      status.textContent = `${money(cents)} 可折抵金額 · ${matches.length} 張符合已填條件 · ${pending.length} 張待確認`;
      matchList.replaceChildren(...matches.map((offer, i) => resultCard(offer, i === 0)));
      pendingBox.hidden = pending.length === 0;
      pendingBox.open = matches.length === 0 && pending.length > 0;
      find('[data-picker-pending-label]').textContent = `還要確認的優惠（${pending.length}）`;
      pendingList.replaceChildren(...pending.map(offer => resultCard(offer, false)));
      excludedBox.hidden = excluded.length === 0;
      excludedBox.open = matches.length === 0 && pending.length === 0;
      find('[data-picker-excluded-label]').textContent = `為什麼其他券不合適（${excluded.length}）`;
      excludedList.replaceChildren(...excluded.map(({ coupon, reasons }) => {
        const item = document.createElement('li');
        item.textContent = `${coupon.code} · ${reasons.join('、')}`;
        return item;
      }));
      results.hidden = false;
      if (focusResult) title.focus();
    }

    showAvailability(todayTW());
    form.addEventListener('submit', event => {
      event.preventDefault();
      render(true);
    });
    form.addEventListener('change', () => {
      if (!results.hidden || error.textContent) render(false);
    });
    amount.addEventListener('input', () => {
      results.hidden = true;
      amount.removeAttribute('aria-invalid');
      error.textContent = '';
    });
  }
</script>

<style>
  .picker { margin: 24px 0; border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); box-shadow: var(--shadow); overflow: clip; }
  .picker [hidden] { display: none !important; }
  .picker-head { list-style: none; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 14px; padding: 17px 20px; cursor: pointer; background: var(--accent-soft); }
  .picker-head::-webkit-details-marker { display: none; }
  .picker-head:focus-visible { outline: 2px solid var(--accent); outline-offset: -3px; }
  .picker-icon { display: grid; place-items: center; width: 46px; height: 46px; background: var(--card); color: var(--accent); border-radius: 12px; }
  .picker-intro { display: grid; gap: 2px; line-height: 1.45; }
  .picker-kicker { font-size: 12px; font-weight: 750; letter-spacing: .06em; color: var(--accent); }
  .picker-intro strong { font-size: clamp(17px, 3.5vw, 23px); letter-spacing: -.02em; }
  .picker-description, .picker-note { color: var(--muted); font-size: 14px; }
  .picker-toggle { display: flex; gap: 6px; align-items: center; color: var(--accent); font-size: 14px; font-weight: 700; }
  .picker[open] .picker-toggle svg { transform: rotate(180deg); }
  .picker-body { padding: 18px 20px; }
  .picker fieldset { border: 0; margin: 0; padding: 0; min-inline-size: 0; }
  .picker-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 13px 16px; }
  .picker-field { min-width: 0; }
  .picker-field label { display: block; font-weight: 700; margin-bottom: 5px; font-size: 14px; }
  .picker-field small { color: var(--muted); font-weight: 400; }
  .picker-field input, .picker-field select { width: 100%; min-height: 44px; padding: 7px 9px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--fg); font: inherit; min-width: 0; }
  .picker-amount { position: relative; }
  .picker-amount span { position: absolute; top: 50%; left: 10px; transform: translateY(-50%); color: var(--muted); pointer-events: none; font-size: 14px; }
  .picker-amount input { padding-inline-start: 43px; }
  .picker-note { margin: 9px 0; line-height: 1.55; }
  .picker-error { color: var(--warn); font-size: 14px; margin: 8px 0; }
  .picker-error:empty { display: none; }
  .picker-submit { display: inline-flex; gap: 10px; justify-content: center; min-height: 44px; padding: 8px 15px; border: 1px solid var(--accent); border-radius: 8px; background: var(--accent); color: var(--bg); font: inherit; font-weight: 750; cursor: pointer; }
  .picker input:focus-visible, .picker select:focus-visible, .picker button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .picker-results { margin-top: 18px; padding-top: 13px; border-top: 1px dashed var(--line); }
  .picker-results h3 { margin: 0; font-size: 18px; scroll-margin-block-start: 12px; }
  .picker-result { margin-top: 10px; padding: 13px; background: var(--bg); border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: 8px; }
  .picker-result-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 5px 12px; }
  .picker-result-label { font-size: 12px; color: var(--accent); font-weight: 750; margin: 0; }
  .picker-savings { color: var(--accent); font-variant-numeric: tabular-nums; font-weight: 800; }
  .picker-result-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 7px 12px; }
  .picker-result-actions code { font-size: 14px; font-weight: 700; overflow-wrap: anywhere; }
  .picker-result-actions .copybtn { padding: 4px 9px; min-height: 36px; color: var(--bg); }
  .picker-result-actions .copybtn.done { color: var(--accent); }
  .picker-result-actions a { display: inline-flex; align-items: center; min-height: 36px; font-size: 14px; }
  .picker-extra { padding-block: 7px; margin-top: 5px; }
  .picker-extra summary { cursor: pointer; font-size: 14px; font-weight: 700; }
  .picker-extra ul { padding-inline-start: 1.25em; margin: 6px 0 0; font-size: 14px; color: var(--muted); }
  .picker-foot { margin: 14px 0 0; color: var(--muted); font-size: 13px; line-height: 1.55; }
  .visually-hidden { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 530px) {
    .picker-head { padding: 14px; gap: 10px; }
    .picker-icon { width: 35px; height: 35px; border-radius: 8px; }
    .picker-icon svg { width: 23px; height: 23px; }
    .picker-toggle span { display: none; }
    .picker-body { padding: 14px; }
    .picker-fields { grid-template-columns: 1fr; gap: 11px; }
    .picker-submit { width: 100%; }
  }
</style>
