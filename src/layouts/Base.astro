---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  /** 空壳页（既没码也没活动）传 true：输出 noindex,follow，不参与排名但仍传递内链。 */
  noindex?: boolean;
  /** 面包屑（首頁 → 品牌），有就输出 BreadcrumbList */
  breadcrumb?: { name: string; url: string }[];
}
const { title, description, canonical, noindex = false, breadcrumb } = Astro.props;
const SITE = 'https://promocodeasia.com';
const url = canonical ?? new URL(Astro.url.pathname, SITE).toString();
// 结构化数据。Google 对优惠码没有富摘要，这里只放 WebSite + Breadcrumb——零成本、不撒谎。
const ld: Record<string, unknown>[] = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'PromoCodeAsia', url: SITE + '/', inLanguage: 'zh-Hant' },
];
if (breadcrumb && breadcrumb.length) {
  ld.push({
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: breadcrumb.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: SITE + b.url })),
  });
}
---
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta name="twitter:card" content="summary" />
  {/* Admitad(Mitgo) 流量源归属验证 —— ad space「PromoCodeAsia」，验证通过后可删 */}
  <meta name="mitgo-verification" content="33ce24bc-5535-45e0-b513-dd54919d4863" />

  {/* GA4 —— 衡量 ID G-RYKYJQL028（媒体资源 555087477 / 数据流 15812390607） */}
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-RYKYJQL028"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-RYKYJQL028');
  </script>
</head>
<body>
  <header class="topbar">
    <div class="wrap">
      <a class="brandmark" href="/">PromoCode<span>Asia</span></a>
      <nav>
        <a href="/">品牌</a>
        <a href="/changes/">異動紀錄</a>
        <a href="/about/">我們怎麼核對</a>
      </nav>
    </div>
  </header>

  <main>
    <div class="wrap"><slot /></div>
  </main>

  <footer>
    <div class="wrap">
      <p>本站每一組優惠碼都標示「最後核對日期」與官方出處。沒核對過的碼不會出現在這裡——寧可寫「目前沒有公開碼」，也不放過期碼充數。</p>
      <p>部分品牌連結為合作推廣連結；是否使用不影響你在該品牌所付的價格。</p>
      <p>© 2026 PromoCodeAsia</p>
    </div>
  </footer>

  <script>
    /**
     * 三个事件，回答三个不同的问题（别混成一个「点击」）：
     *   copy_code        —— 有多少人真的打算去用这组码
     *   merchant_outbound —— 有多少人真的去了商家（带 link_type 区分联盟链接/官方链接）
     *   source_open      —— 有多少人去查了出处。这是查证兴趣，**不是购买意图**，
     *                        不能和上面两个加在一起当转化。
     *
     * commissionable 一起上报：Klook 的银行码注定零佣金，把它算进收入预期
     * 会让整个漏斗看起来比实际赚钱。'unknown' 表示条款没查证过，同样不能当收入。
     */
    const ev = (name: string, params: Record<string, unknown>) => {
      const g = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
      if (typeof g === 'function') g('event', name, params);
    };

    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;

      const out = t.closest<HTMLAnchorElement>('.js-merchant');
      if (out) {
        ev('merchant_outbound', {
          brand: out.dataset.brand || '',
          link_type: out.dataset.linkType || 'official',
        });
      }

      const src = t.closest<HTMLAnchorElement>('.js-source');
      if (src) {
        ev('source_open', { brand: src.dataset.brand || '', code_id: src.dataset.codeId || '' });
      }
    });

    // 复制码：优先用 Clipboard API，不可用时回退到 execCommand（http 或旧浏览器）
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.copybtn');
      if (!btn) return;
      ev('copy_code', {
        brand: btn.dataset.brand || '',
        code_id: btn.dataset.code || '',
        commissionable: btn.dataset.commissionable || 'unknown',
      });
      const code = btn.dataset.code || '';
      const done = () => {
        const old = btn.textContent;
        btn.textContent = '已複製';
        btn.classList.add('done');
        setTimeout(() => { btn.textContent = old; btn.classList.remove('done'); }, 1600);
      };
      if (navigator.clipboard?.writeText) {
        navigator.clipboard.writeText(code).then(done).catch(() => {});
      } else {
        const ta = document.createElement('textarea');
        ta.value = code; document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); done(); } finally { ta.remove(); }
      }
    });
  </script>
</body>
</html>
