---
import Base from '../layouts/Base.astro';
import { BRANDS } from '../data/brands';
const withCodes = BRANDS.filter((b) => b.codes.length > 0).length;
---
<Base
  title="優惠碼查詢｜每一組都標示核對日期與出處"
  description="Klook、iHerb、Trip.com、KKday 等品牌的優惠碼整理。每組碼標示我們最後核對的日期和官方出處，沒核對過的不放。">
  <h1>優惠碼，只放我們核對過的</h1>
  <p class="sub">目前收錄 {BRANDS.length} 個品牌，其中 {withCodes} 個有現行可用的公開碼。</p>

  <div class="card">
    <strong>為什麼要另外做一個站</strong>
    <p style="margin:8px 0 0">
      我們實測過市面上的優惠碼站：同一個 Klook 銀行碼，聚合站寫 <code class="c">HUWNAN2640009</code>，
      Klook 官方頁上是 <code class="c">HUWNAN269509</code>——直接對不上。另一個知名站的品牌頁列了 20 組碼，
      沒有一組標示核對日期，其中一組的到期日寫著 2133 年。
    </p>
    <p style="margin:8px 0 0">所以這裡的規則很簡單：<strong>每組碼都標明什麼時候核對的、從哪裡核對的</strong>；查不到有效碼時就直說沒有。</p>
  </div>

  <h2>品牌</h2>
  {BRANDS.map((b) => (
    <div class="card">
      <div><a href={`/store/${b.slug}/`}><strong>{b.name}</strong></a> — {b.tagline}</div>
      <div class="meta">
        {b.codes.length > 0
          ? `${b.codes.length} 組已核對的優惠碼`
          : '目前沒有已核對的公開碼'}
        {b.campaigns.length > 0 ? `・${b.campaigns.length} 檔進行中的活動` : ''}
      </div>
    </div>
  ))}
</Base>
