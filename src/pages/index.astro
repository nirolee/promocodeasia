---
import Base from '../layouts/Base.astro';
import { BRANDS } from '../data/brands';
import { liveCodes, todayTW } from '../lib/codes';
// 计数必须和品牌页用同一套过期口径，否则会出现「首頁說 7 組、點進去只剩 1 組」
const today = todayTW();
const live = new Map(BRANDS.map((b) => [b.slug, liveCodes(b, today)]));
const withCodes = BRANDS.filter((b) => live.get(b.slug)!.length > 0);
const allDates = BRANDS.flatMap((b) => live.get(b.slug)!.map((c) => c.verifiedAt)).sort();
const latest = allDates.at(-1);
const initials = (s: string) => s.replace(/[^A-Za-z]/g, '').slice(0, 2).toUpperCase() || s.slice(0, 1);
---
<Base
  title="優惠碼查詢｜每一組都標示核對日期與出處 - PromoCodeAsia"
  description="Klook、iHerb、Trip.com、KKday 等品牌的優惠碼整理。每組碼標示我們最後核對的日期與官方出處；查不到有效碼時就直說沒有，不放過期碼。">
  <h1>優惠碼，只放我們核對過的</h1>
  <p class="lede">
    收錄 {BRANDS.length} 個品牌{latest ? `・最後一次核對 ${latest}` : ''}。
    其中 {withCodes.length} 個目前有可用的公開碼。
  </p>

  <div class="trust">
    <strong>為什麼要再做一個優惠碼站</strong>
    <p>我們實測過市面上的站：同一組 Klook 銀行碼，聚合站寫 <code>HUWNAN2640009</code>，Klook 官方頁上是 <code>HUWNAN269509</code>——直接對不上。另一個知名站的品牌頁列了 20 組碼，沒有一組標核對日期，其中一組的到期日寫著 2133 年。</p>
    <p>所以這裡只有兩條規則：<b>每組碼都標明何時核對、從哪核對</b>；<b>查不到有效碼就直說沒有</b>。</p>
  </div>

  <h2>品牌</h2>
  <p class="lede" style="margin-bottom:14px">
    找不到你要的品牌？我們把<a href="/unavailable/">拿不到、驗不了的品牌單獨列了一頁</a>，
    說明原因並告訴你該去哪裡找——不用在這裡空找。
  </p>
  <div class="grid">
    {BRANDS.map((b) => (
      <a class="brandcard" href={`/store/${b.slug}/`}>
        <div class="row">
          <div class="avatar">{initials(b.nameEn)}</div>
          <div>
            <div class="nm">{b.name}</div>
            <div class="tag">{b.tagline}</div>
          </div>
        </div>
        <div class="foot">
          {live.get(b.slug)!.length > 0
            ? <span class="pill pill-ok">✓ {live.get(b.slug)!.length} 組已核對</span>
            : <span class="pill pill-none">目前沒有公開碼</span>}
          {b.campaigns.length > 0 && <span class="pill pill-warn">{b.campaigns.length} 檔活動進行中</span>}
        </div>
      </a>
    ))}
  </div>
</Base>
