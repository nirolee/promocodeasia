---
import Base from '../../layouts/Base.astro';
import { BRANDS } from '../../data/brands';
import { liveCodes, expiredCodes, isStale, daysSince, daysUntil, todayTW, weekdayTW, groupByCard, hasSubstance, versionEnd, versionStale, versionLabel, STALE_AFTER_DAYS } from '../../lib/codes';
export function getStaticPaths() {
  return BRANDS.map((b) => ({ params: { slug: b.slug }, props: { brand: b } }));
}
const { brand } = Astro.props;
const today = todayTW();
// 过期的码不进 HTML。空态里要说明「上一组什么时候失效的」，所以另外留一份。
const codes = liveCodes(brand, today);
const dropped = expiredCodes(brand, today);
const lastDropped = dropped.map((c) => c.expiresAt!).sort().at(-1);
const latest = codes.map((c) => c.verifiedAt).sort().at(-1);
const initials = brand.nameEn.replace(/[^A-Za-z]/g, '').slice(0, 2).toUpperCase();
// 标题：竞品这个品类的卖点是「組數 + 月份」（實測前排標題都寫「45 組」「2026年9月最新」），
// 组数我们拼不过就算了，但「逐組核對」是他们没有的——排第一那篇自己标的更新日是 2026-08-03。
// 日期用 M/D 短式，标题在 SERP 上只有约 30 个全角字的空间。
const shortDate = latest ? `${Number(latest.slice(5, 7))}/${Number(latest.slice(8, 10))}` : '';
// 無碼但有活動的品牌（Agoda、CASETiFY）：搜「XX 優惠碼」的人以為有碼可貼，
// 我們的價值恰恰是告訴他「沒有碼，但優惠是這樣拿的」——標題要把這件事說出來，
// 不然只寫「目前沒有」，SERP 上就是個零點擊的死頁。
// 主词看品牌（KKday 是「折扣碼」，其余「優惠碼」，见 brands.ts 的 term 注释）；副词写进 description 和正文
const term = brand.term ?? '優惠碼';
const alt = term === '折扣碼' ? '優惠碼' : '折扣碼';
const pageTitle = codes.length > 0
  ? `${brand.name}${term}｜${codes.length} 組，${shortDate} 逐組核對 - PromoCodeAsia`
  : brand.campaigns.length > 0
    ? `${brand.name}${term}｜沒有公開碼，${brand.campaigns.length} 檔官方優惠這樣拿 - PromoCodeAsia`
    : `${brand.name}${term}｜目前沒有可用的公開碼 - PromoCodeAsia`;
const withExpiry = codes.filter((c) => c.expiresAt).length;
const pageDesc = codes.length > 0
  ? `${brand.name}${term}（${alt}）${codes.length} 組，每組標明適用條件、${shortDate} 的核對日期與官方出處`
    + `${withExpiry > 0 ? `，其中 ${withExpiry} 組附官方失效日` : ''}。過了失效日自動下架，不留過期碼。`
  : brand.campaigns.length > 0
    ? `${brand.name} 目前沒有可輸入的公開優惠碼，但官方優惠是有的。這頁講清楚 ${brand.campaigns.length} 檔怎麼拿、要不要登入、有什麼條件，每檔附核對日期與官方出處。`
    : `我們目前查不到 ${brand.name} 可輸入的公開優惠碼，所以這頁直接寫明沒有，不放沒驗證過的碼充數。`;
// 出站链接：联盟批下来之前先用官方地址。
// 为什么不等联盟批：读者看完码在这页是死路一条，没有任何下一步。
// 等批准再补，中间这段时间「有多少人真想买」的数据就永远拿不到了。
const merchantHref = brand.affiliateUrl || brand.officialUrl;
const isAffiliate = Boolean(brand.affiliateUrl);
// 既没码也没活动 = 空壳页，不参与排名（sitemap 那边用同一个判据排除）
const substantial = hasSubstance(brand, today);
// 「谁能用」两个入口。为什么要做：补完码之后 Klook 30 组、KKday 30 组，
// 平铺一个列表，拿玉山卡的读者得逐条扫完才知道哪条跟自己有关。
const WD_NAMES = ['一', '二', '三', '四', '五', '六', '日'];
const wd = weekdayTW(today);
// 限定星期的码（KKday 有 9 组）。竞品没人做「今天能用哪几组」——它既是点击理由，
// 也是唯一能让人每天回来看一次的东西。
const weekdayCodes = codes.filter((c) => c.weekday !== undefined);
const todayCodes = weekdayCodes.filter((c) => c.weekday === wd);
// 卡别索引：只在真的多到需要导航时才出（阈值 8 组，低于这个数直接扫列表更快）
const cardGroups = groupByCard(codes);
// 同一张卡的码排在一起。原数据顺序是按官方表格来的，同一家银行的两组会隔十几条，
// 锚点跳过去只能看到一条。没有 card 的（按类别/星期限定）保持原顺序排在后面。
const ordered = [
  ...cardGroups.flatMap((g) => g.codes),
  ...codes.filter((c) => !c.card),
];
// 每张卡的第一组码挂锚点
const anchorOf = new Map(cardGroups.map((g) => [g.codes[0].code, g.card]));
const showCardIndex = cardGroups.length >= 8;
---
<Base
  noindex={!substantial}
  title={pageTitle}
  description={pageDesc}
  breadcrumb={[{ name: '首頁', url: '/' }, { name: `${brand.name}${term}`, url: `/store/${brand.slug}/` }]}>
  <div class="row" style="display:flex;align-items:center;gap:14px;margin-bottom:8px">
    <div class="avatar" style="width:48px;height:48px;font-size:18px">{initials}</div>
    <div>
      <h1 style="margin:0">{brand.name}{term}</h1>
      <p class="lede" style="margin:2px 0 0">{brand.tagline}</p>
    </div>
  </div>
  <p class="lede">
    {latest
      ? <span class="pill pill-ok">✓ 最後核對 {latest}</span>
      : <span class="pill pill-none">尚無已核對的公開碼</span>}
  </p>

  {weekdayCodes.length > 0 && (
    <div class="today" id="today-box">
      <strong>今天（星期<span id="today-wd">{WD_NAMES[wd]}</span>）可以用的限定碼</strong>
      <ul id="today-list" class="todaylist">
        {todayCodes.map((c) => (
          <li data-weekday={c.weekday}><b>{c.code}</b>　{c.benefit}</li>
        ))}
      </ul>
      <p id="today-none" class="kv" hidden={todayCodes.length > 0}>
        今天沒有星期限定碼；下面那些不限星期的照常可用。
      </p>
      <p class="kv">
        這個品牌有 {weekdayCodes.length} 組碼綁定星期幾下單，每天能用的不一樣。
      </p>
    </div>
  )}

  {showCardIndex && (
    <div class="cardindex">
      <strong>先找你的卡</strong>
      <p class="kv">共 {cardGroups.length} 種付款方式，點一下跳到那組。</p>
      <ul class="cardlist">
        {cardGroups.map((g) => (
          <li><a href={`#card-${encodeURIComponent(g.card)}`}>{g.card}<span class="n">{g.codes.length}</span></a></li>
        ))}
      </ul>
    </div>
  )}

  <h2>優惠碼</h2>
  {ordered.map((c) => (
    <div class="codecard"
      id={anchorOf.has(c.code) ? `card-${encodeURIComponent(anchorOf.get(c.code)!)}` : undefined}
      data-weekday={c.weekday ?? ''}
      data-version-end={versionEnd(c) ?? ''}
      data-version-label={c.officialVersion ? versionLabel(c.officialVersion) : ''}
      data-expires={c.expiresAt ?? ''} data-verified={c.verifiedAt}>
      <div class="benefit">{c.benefit}</div>
      <div class="codeline">
        <div class="codeval">{c.code}</div>
        <button
          class="copybtn"
          data-code={c.code}
          data-brand={brand.slug}
          data-commissionable={c.commissionable ?? 'unknown'}
          type="button">複製</button>
      </div>
      <div class="kv"><b>適用條件</b>：{c.restriction}</div>
      <div class="kv">
        {versionStale(c, today)
          ? <span class="pill pill-warn js-verify">⚠ 此為 {versionLabel(c.officialVersion!)} 版，官方頁註明每月更換，新版尚未核對</span>
          : isStale(c, today)
          ? <span class="pill pill-warn js-verify">⚠ {c.verifiedAt} 核對，已 {daysSince(c.verifiedAt, today)} 天未複查</span>
          : <span class="pill pill-ok js-verify">✓ {c.verifiedAt} 核對</span>}
        　出處：<a
          class="js-source"
          data-brand={brand.slug}
          data-code-id={c.code}
          href={c.source} rel="nofollow noopener" target="_blank">品牌官方頁</a>
        {/*
          官方没给失效日、但标了「N 月版本」的码（Klook 30 组全是）：
          月底前显示换版倒数；月底后由上面的 js-verify 降级，这里隐藏。
          不走 expiresAt —— 那是官方标注的失效日，Klook 没公布，不替它编。
        */}
        {versionEnd(c) && !versionStale(c, today) && (
          <span class="js-version" data-version-end={versionEnd(c)} data-version-label={versionLabel(c.officialVersion!)}>
            　<span class={daysUntil(versionEnd(c)!, today) <= 3 ? 'pill pill-warn' : 'pill pill-none'}>
              {versionLabel(c.officialVersion!)} 版・官方頁註明月底換版・剩 {daysUntil(versionEnd(c)!, today)} 天
            </span>
          </span>
        )}
        {c.expiresAt && (
          <span class="js-expiry" data-expires={c.expiresAt}>
            　<span class={daysUntil(c.expiresAt, today) <= 3 ? 'pill pill-warn' : 'pill pill-none'}>
              {daysUntil(c.expiresAt, today) === 0
                ? `今天是最後一天（${c.expiresAt}）`
                : `${c.expiresAt} 失效・剩 ${daysUntil(c.expiresAt, today)} 天`}
            </span>
          </span>
        )}
      </div>
    </div>
  ))}

  {/* 空态。codes 为空时直接显示；客户端把最后一张卡摘掉时由脚本 removeAttribute('hidden')。 */}
  <div class="empty" id="codes-empty" hidden={codes.length > 0}>
    <strong>目前沒有已核對的公開優惠碼。</strong>
    <p>
      截至 {today}，我們在所列的官方渠道未找到可核對的公開碼——
      「查不到」不等於「不存在」，只表示我們沒有能標明出處的證據。
      {lastDropped
        ? `上一批公開碼已於 ${lastDropped} 到期，我們還沒核到新的——寧可先空著，也不把過期碼留在頁上。`
        : `${brand.name} 現階段的折扣多半綁在活動或會員身分上。`}
      一旦有可用的碼，我們會補上並標註核對日期。
    </p>
  </div>

  {brand.campaigns.length > 0 && (
    <>
      <h2>進行中的活動（不需輸入碼）</h2>
      {brand.campaigns.map((c) => (
        <div class="campaign">
          <strong>{c.title}</strong>
          <div class="kv">{c.period}</div>
          <p style="margin:8px 0 0">{c.detail}</p>
          <div class="kv">出處：<a href={c.source} rel="nofollow noopener" target="_blank">品牌官方頁</a></div>
        </div>
      ))}
    </>
  )}

  {/*
    出站入口。affiliateUrl 为空时退到官方地址，rel 也跟着换：
    只有真的是推广链接才写 sponsored，否则就是给读者一个普通的官方出口。
    联盟批下来后只要把 brands.ts 的 affiliateUrl 填上，这里自动切换。
  */}
  <p style="margin:22px 0">
    <a
      class="js-merchant outbtn"
      href={merchantHref}
      data-brand={brand.slug}
      data-link-type={isAffiliate ? 'affiliate' : 'official'}
      rel={isAffiliate ? 'sponsored noopener' : 'nofollow noopener'}
      target="_blank">前往 {brand.name} 官方網站 →</a>
    {isAffiliate && <span class="kv" style="display:block;margin-top:6px">這是合作推廣連結；是否使用不影響你所付的價格。</span>}
  </p>

  <h2>使用前先確認這三件事</h2>
  <ul class="steps">
    <li>你的付款方式是否符合「適用條件」——台灣的{term}絕大多數綁定特定發卡銀行。</li>
    <li>多數銀行碼需要<b>先點進品牌的活動頁</b>才會生效，直接在結帳頁貼上可能無效。</li>
    <li>每個帳號通常每月限用一次，且數量有限、以結帳順序為準。</li>
  </ul>
  <p class="kv">這頁說的{term}，也就是常見說法裡的{alt}——同一回事，結帳時輸入的那串字。</p>

  {/* 品牌页之间的互链。2026-09-23 审计：之前每个品牌页只被首页一根线连着，页面之间互不认识。
      只列有实质内容的（和 sitemap / noindex 同一判据），空壳页不导权重。 */}
  <h2>其他品牌</h2>
  <p class="kv">
    {BRANDS.filter((b) => b.slug !== brand.slug && hasSubstance(b, today)).map((b, i, arr) => (
      <>
        <a href={`/store/${b.slug}/`}>{b.name}{b.term ?? '優惠碼'}</a>{i < arr.length - 1 ? '　·　' : ''}
      </>
    ))}
    　·　<a href="/changes/">哪些碼快失效</a>
  </p>

  {/*
    客户端兜底。为什么需要：这是静态站，过滤发生在 build 时，而 build 只在 push 时触发。
    如果 9-30 之后没人推代码，构建产物里那 6 组 KKday 银行码会一直挂着——
    页脚却写着「不放過期碼充數」，正好打在唯一的卖点上。所以在浏览器里再判一次。
    同理把「已 N 天未複查」也在客户端重算，否则这个天数会停在最后一次 build 的那天。
  */}
  <script is:inline define:vars={{ staleAfter: STALE_AFTER_DAYS }}>
    (function () {
      var today;
      try {
        today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Shanghai' }).format(new Date());
      } catch (e) {
        return; // 取不到台北日期就什么都不改，保持 build 时的结果
      }
      var cards = document.querySelectorAll('.codecard');
      for (var i = 0; i < cards.length; i++) {
        var el = cards[i];
        var exp = el.getAttribute('data-expires');
        if (exp && exp < today) { el.remove(); continue; }
        var v = el.getAttribute('data-verified');
        var pill = el.querySelector('.js-verify');
        if (!v || !pill) continue;
        var days = Math.round((Date.parse(today) - Date.parse(v)) / 86400000);
        if (days > staleAfter) {
          pill.className = 'pill pill-warn js-verify';
          pill.textContent = '⚠ ' + v + ' 核對，已 ' + days + ' 天未複查';
        }
        // 「N 月版」换版：月底一过就降级核对 pill，月底前刷新倒数。同一个理由——build 只在 push 时跑。
        var vend = el.getAttribute('data-version-end');
        if (vend && pill) {
          var vlab = el.getAttribute('data-version-label') || '';
          var vleft = Math.round((Date.parse(vend) - Date.parse(today)) / 86400000);
          var vbox = el.querySelector('.js-version');
          if (vleft < 0) {
            pill.className = 'pill pill-warn js-verify';
            pill.textContent = '⚠ 此為 ' + vlab + ' 版，官方頁註明每月更換，新版尚未核對';
            if (vbox) vbox.remove();
          } else if (vbox) {
            var vs = vbox.querySelector('.pill');
            if (vs) {
              vs.className = vleft <= 3 ? 'pill pill-warn' : 'pill pill-none';
              vs.textContent = vlab + ' 版・官方頁註明月底換版・剩 ' + vleft + ' 天';
            }
          }
        }
        // 倒数同样要在浏览器里重算，否则「剩 N 天」会停在最后一次 build 的那天
        if (exp) {
          var box = el.querySelector('.js-expiry');
          var span = box && box.querySelector('.pill');
          if (span) {
            var left = Math.round((Date.parse(exp) - Date.parse(today)) / 86400000);
            span.className = left <= 3 ? 'pill pill-warn' : 'pill pill-none';
            span.textContent = left === 0
              ? '今天是最後一天（' + exp + '）'
              : exp + ' 失效・剩 ' + left + ' 天';
          }
        }
      }
      // 星期限定码：build 只在 push 时跑，不重算的话「今天可用」会停在最后一次构建那天。
      // 口径必须和 lib/codes.ts 的 weekdayTW 一致：0=周一。
      var box = document.getElementById('today-box');
      if (box) {
        var names = ['一', '二', '三', '四', '五', '六', '日'];
        var wdNow = (new Date(today + 'T00:00:00Z').getUTCDay() + 6) % 7;
        var lbl = document.getElementById('today-wd');
        if (lbl) lbl.textContent = names[wdNow];
        var list = document.getElementById('today-list');
        if (list) {
          list.innerHTML = '';
          var all = document.querySelectorAll('.codecard[data-weekday]');
          for (var j = 0; j < all.length; j++) {
            var w = all[j].getAttribute('data-weekday');
            if (w === '' || Number(w) !== wdNow) continue;
            var cd = all[j].querySelector('.codeval');
            var bn = all[j].querySelector('.benefit');
            var li = document.createElement('li');
            var b = document.createElement('b');
            b.textContent = cd ? cd.textContent : '';
            li.appendChild(b);
            li.appendChild(document.createTextNode('　' + (bn ? bn.textContent : '')));
            list.appendChild(li);
          }
          var none = document.getElementById('today-none');
          if (none) { if (list.children.length) none.setAttribute('hidden', ''); else none.removeAttribute('hidden'); }
        }
      }

      if (!document.querySelector('.codecard')) {
        var empty = document.getElementById('codes-empty');
        if (empty) empty.removeAttribute('hidden');
      }
    })();
  </script>
</Base>
