---
import Base from '../../layouts/Base.astro';
import { BRANDS } from '../../data/brands';
export function getStaticPaths() {
  return BRANDS.map((b) => ({ params: { slug: b.slug }, props: { brand: b } }));
}
const { brand } = Astro.props;
const latest = brand.codes.map((c) => c.verifiedAt).sort().at(-1);
const initials = brand.nameEn.replace(/[^A-Za-z]/g, '').slice(0, 2).toUpperCase();
---
<Base
  title={`${brand.name}優惠碼${latest ? `（${latest} 核對）` : ''}｜PromoCodeAsia`}
  description={`${brand.name}優惠碼整理：${brand.codes.length > 0 ? `${brand.codes.length} 組已核對的碼，附適用條件` : '目前沒有已核對的公開碼'}。每組標示核對日期與官方出處。`}>
  <div class="row" style="display:flex;align-items:center;gap:14px;margin-bottom:8px">
    <div class="avatar" style="width:48px;height:48px;font-size:18px">{initials}</div>
    <div>
      <h1 style="margin:0">{brand.name}優惠碼</h1>
      <p class="lede" style="margin:2px 0 0">{brand.tagline}</p>
    </div>
  </div>
  <p class="lede">
    {latest
      ? <span class="pill pill-ok">✓ 最後核對 {latest}</span>
      : <span class="pill pill-none">尚無已核對的公開碼</span>}
  </p>

  <h2>優惠碼</h2>
  {brand.codes.length === 0 ? (
    <div class="empty">
      <strong>目前沒有已核對的公開優惠碼。</strong>
      <p>
        我們寧可這樣寫，也不放沒驗證過的碼。{brand.name} 現階段的折扣多半綁在活動或會員身分上，
        建議直接看 <a href={brand.officialUrl} rel="nofollow noopener" target="_blank">官方頁面</a>。
        一旦有可用的碼，我們會補上並標註核對日期。
      </p>
    </div>
  ) : (
    brand.codes.map((c) => (
      <div class="codecard">
        <div class="benefit">{c.benefit}</div>
        <div class="codeline">
          <div class="codeval">{c.code}</div>
          <button class="copybtn" data-code={c.code} type="button">複製</button>
        </div>
        <div class="kv"><b>適用條件</b>：{c.restriction}</div>
        <div class="kv">
          <span class="pill pill-ok">✓ {c.verifiedAt} 核對</span>
          　出處：<a href={c.source} rel="nofollow noopener" target="_blank">品牌官方頁</a>
          {c.expiresAt ? `　官方標示失效日：${c.expiresAt}` : ''}
        </div>
      </div>
    ))
  )}

  {brand.campaigns.length > 0 && (
    <>
      <h2>進行中的活動（不需輸入碼）</h2>
      {brand.campaigns.map((c) => (
        <div class="campaign">
          <strong>{c.title}</strong>
          <div class="kv">{c.period}</div>
          <p style="margin:8px 0 0">{c.detail}</p>
          <div class="kv">出處：<a href={c.source} rel="nofollow noopener" target="_blank">品牌官方頁</a></div>
        </div>
      ))}
    </>
  )}

  <h2>使用前先確認這三件事</h2>
  <ul class="steps">
    <li>你的付款方式是否符合「適用條件」——台灣的優惠碼絕大多數綁定特定發卡銀行。</li>
    <li>多數銀行碼需要<b>先點進品牌的活動頁</b>才會生效，直接在結帳頁貼上可能無效。</li>
    <li>每個帳號通常每月限用一次，且數量有限、以結帳順序為準。</li>
  </ul>
</Base>
