---
import Base from '../layouts/Base.astro';
// 这一页不为排名而做，为的是不让读者白跑。
// 数据来自 2026-09-21 的繁中券词全库（495 词 / 20.2 万月搜）与各联盟商家库的交集：
// 这些品牌有真实搜索需求，但我们拿不到联盟、也就给不了可靠的码，如实说明并指向官方。
const groups = [
  {
    title: '外送與速食',
    why: '這些品牌在台灣沒有開放聯盟推廣，優惠多半綁在自家 App 或會員帳號上。',
    brands: ['Uber Eats', 'foodpanda', '肯德基 KFC', '必勝客', '漢堡王'],
    tip: '折扣通常在各自 App 的「優惠券」分頁領取，網頁端看不到。',
  },
  {
    title: '日本實體藥妝與電器',
    why: '這類是到店出示的紙本／條碼折價券，不經過線上結帳，聯盟系統追蹤不到。',
    brands: ['Bic Camera', '松本清', 'SUGI 藥局', 'Yodobashi', '唐吉訶德'],
    tip: '免稅＋額外折扣券多半在品牌的台灣官網或旅遊平台的「日本優惠券」專頁發放，出國前先存手機。',
  },
  {
    title: '台港本地電商',
    why: '這些平台走的是台灣本地的聯盟網路（通路王、聯盟網），對境外推廣者不開放。',
    brands: ['HKTVmall', 'momo', 'PChome', '旋轉拍賣', '賣貨便', '淘寶'],
    tip: '這類平台的折扣多為站內活動與信用卡回饋，直接看官方活動頁最準。',
  },
  {
    title: '只給自動折扣連結、不發碼',
    why: 'Trip.com、Surfshark、NordVPN 的折扣掛在活動頁或方案頁上自動套用，官方不發可輸入的碼；我們核過，不是漏收。',
    brands: ['Trip.com', 'Surfshark', 'NordVPN'],
    tip: '這三家的頁面我們留著（/store/trip-com/、/store/surfshark/、/store/nordvpn/），官方一旦發碼就會補上並標核對日期。',
  },
  {
    title: '訂房平台（部分）',
    why: 'Booking.com 走的聯盟對新站有流量門檻，我們還沒過；易遊網不開放境外推廣。',
    brands: ['Booking.com', '易遊網 ezTravel'],
    tip: 'Agoda 我們已經單獨做了一頁（它沒有可輸入的碼，但優惠券怎麼領講清楚了），見 /store/agoda/。同一晚住宿在不同平台的含稅價常差不少，比完再訂。',
  },
];
const total = groups.reduce((n, g) => n + g.brands.length, 0);
---
<Base
  title="我們目前提供不了的優惠碼（誠實清單）｜PromoCodeAsia"
  description="有些品牌的優惠碼我們拿不到、也驗不了，與其放沒驗證過的碼，不如直接說明原因並告訴你該去哪裡找。">
  <h1>我們目前提供不了的</h1>
  <p class="lede">共 {total} 個品牌。放在這裡是為了不讓你白跑一趟。</p>

  <div class="trust">
    <strong>為什麼要專門做這一頁</strong>
    <p>你搜「某某優惠碼」時，多數站都會給你一個頁面、列一堆碼——即使那些碼早就失效，或者根本是湊數的。我們的規則是<b>沒核對過就不放</b>，那就會有一批品牌永遠是空的。</p>
    <p>與其讓你點進來看到「目前沒有」，不如一次講清楚：哪些是我們拿不到的、為什麼拿不到、以及你該去哪裡找。</p>
  </div>

  {groups.map((g) => (
    <>
      <h2>{g.title}</h2>
      <div class="codecard">
        <div class="kv" style="margin-top:0"><b>為什麼沒有</b>：{g.why}</div>
        <div class="kv"><b>涵蓋品牌</b>：{g.brands.join('、')}</div>
        <div class="kv"><b>建議</b>：{g.tip}</div>
      </div>
    </>
  ))}

  <h2>會變嗎</h2>
  <p>會。只要我們接入了對應的聯盟、拿得到可驗證的碼，就會把品牌從這頁移到正式頁面並標上核對日期。反過來，如果某個品牌的碼失效且長期沒有新的，它也會被移到這裡。</p>
</Base>
